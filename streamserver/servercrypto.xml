<?xml version="1.0" encoding="UTF-8"?>
<ProxyCryptoConfig version="1.0">
    <SymCipherSuite>
        <Algorithm>AES</Algorithm> <!-- Ex: AES, ChaCha20, RC6, etc -->
        <Mode>GCM</Mode> <!-- Ex: GCM, CCB, CTR, Poly1305 or NULL -->
        <InitializationVector>
            <IV>IV Value</IV> <!-- Ex: hexadecimal or base 64 rep. or NULL -->
            <IVSIZE>IV Size</IVSIZE> <!-- Number of bits of IV or NULL -->
        </InitializationVector>
        <Padding>NoPadding</Padding> <!-- Ex: PKCS5Padding or NULL -->
    </SymCipherSuite>
    <MACSuite>
        <Algorithm>ALG</Algorithm> <!-- Ex: HMAC-SHA256, HMAC-SHA384, HMAC-SHA-512 or NULL -->
    </MACSuite>
    <ConfiguredKeys>
        <SymmetricKey>
            <SKey>key</SKey> <!-- Key material in hexadecimal or base64 -->
            <Keysize>SIZE</Keysize> <!-- 128, 192 or 256 bits -->
        </SymmetricKey>
        <MACKey>
            <MacKey>key-mac</MacKey> <!-- MAC key in hexadecimal or Base64 or NULL -->
            <MacKeySize>Size</MacKeySize> <!-- Number of bits of the MAC key, or NULL -->
        </MACKey>
    </ConfiguredKeys>
</ProxyCryptoConfig>
